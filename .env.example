# API base URL for host dev server (vite). The Dockerized UI uses its /api proxy instead.
VITE_API_URL=http://localhost:8081/api
# Set to "true" to ship the frontend with mocked API (MSW) — used for the Vercel prototype.
# When true, the UI intercepts /api/* with realistic delays and shows a blocking prototype notice on first load.
VITE_MOCK_API=false
